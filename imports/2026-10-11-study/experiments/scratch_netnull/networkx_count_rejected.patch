diff --git a/networkx/algorithms/tests/test_swap.py b/networkx/algorithms/tests/test_swap.py
index e765bd5e..1bcd6343 100644
--- a/networkx/algorithms/tests/test_swap.py
+++ b/networkx/algorithms/tests/test_swap.py
@@ -177,3 +177,30 @@ def test_less_than_3_edges():
     G.add_nodes_from([0, 1, 2, 3])
     with pytest.raises(nx.NetworkXError, match=".*fewer than 2 edges"):
         nx.double_edge_swap(G)
+
+
+def test_double_edge_swap_count_rejected_unique_realization():
+    # K4 is the only graph with degree sequence [3, 3, 3, 3]: every attempt is
+    # rejected. Counting rejected attempts must terminate and leave G unchanged.
+    G = nx.complete_graph(4)
+    H = nx.double_edge_swap(G.copy(), nswap=5, max_tries=10, count_rejected=True)
+    assert nx.utils.edges_equal(G.edges, H.edges)
+
+
+def test_double_edge_swap_count_rejected_uniform():
+    # Degree sequence [4, 4, 2, 2, 2, 2] has 13 labeled realizations. The
+    # default (count successes only) samples them proportionally to the number
+    # of valid swaps (ratio 2 between extremes); counting rejected attempts
+    # samples them uniformly.
+    import random
+
+    rng = random.Random(42)
+    G = nx.Graph([(0, 1), (0, 2), (0, 3), (0, 4), (1, 2), (1, 3), (1, 5), (4, 5)])
+    counts = {}
+    for _ in range(4000):
+        nx.double_edge_swap(G, nswap=20, max_tries=10**5, seed=rng, count_rejected=True)
+        key = frozenset(frozenset(e) for e in G.edges)
+        counts[key] = counts.get(key, 0) + 1
+    assert len(counts) == 13
+    freqs = sorted(c / 4000 for c in counts.values())
+    assert freqs[-1] / freqs[0] < 1.5
